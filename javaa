    public static class SecurityUtils {
        public static String generateSalt() {
            byte[] salt = new byte[16];
            new SecureRandom().nextBytes(salt);
            return Base64.getEncoder().encodeToString(salt);
        }

        public static String hashPassword(String password, String salt) {
            try {
                MessageDigest md = MessageDigest.getInstance("SHA-256");
                md.update(Base64.getDecoder().decode(salt));
                byte[] hashedBytes = md.digest(password.getBytes(StandardCharsets.UTF_8));
                StringBuilder sb = new StringBuilder();
                for (byte b : hashedBytes) {
                    sb.append(String.format("%02x", b));
                }
                return sb.toString();
            } catch (Exception e) {
                throw new RuntimeException("SHA-256 algorithm error", e);
            }
        }
    }

    // ==========================================
    // 4. HEURISTIC THREAT DETECTION ENGINE
    // ==========================================
    public static class ThreatDetectionEngine {
        // Sliding window tracking: IP -> (Port -> Timestamp)
        private final Map<String, Map<Integer, Long>> portScanTracker = new ConcurrentHashMap<>();
        private final Map<String, String> arpTableCache = new ConcurrentHashMap<>();

        public ThreatDetectionEngine() {
            // Seed known baseline ARP bindings
            arpTableCache.put("192.168.1.1", "00:50:56:FE:01:A1");
            arpTableCache.put("192.168.1.105", "A4:83:E7:21:44:90");
        }

        public Optional<ThreatAlert> evaluatePacket(NetworkPacket packet) {
            long now = System.currentTimeMillis();

            // RULE 1: Port Scan Detection (>= 5 distinct ports probed in under 10 seconds)
            if ("TCP".equals(packet.protocol) || "UDP".equals(packet.protocol)) {
                portScanTracker.putIfAbsent(packet.sourceIp, new ConcurrentHashMap<>());
                Map<Integer, Long> portsProbed = portScanTracker.get(packet.sourceIp);
                portsProbed.put(packet.port, now);

                // Evict expired entries older than 10 seconds
                portsProbed.entrySet().removeIf(entry -> now - entry.getValue() > 10000);

                if (portsProbed.size() >= 5) {
                    portsProbed.clear(); // Reset window after detection
                    return Optional.of(new ThreatAlert(
                        "THR-" + (1000 + new Random().nextInt(9000)),
                        AlertSeverity.HIGH,
                        "PORT_SCAN",
                        packet.sourceIp,
                        packet.port,
                        "Sequential host sweep: probed >= 5 unique destination ports within 10s window."
                    ));
                }
            }

            // RULE 2: Insecure/Vulnerable Port Target (Telnet 23, SMB 445)
            if (packet.port == 23) {
                return Optional.of(new ThreatAlert(
                    "THR-" + (1000 + new Random().nextInt(9000)),
                    AlertSeverity.CRITICAL,
                    "SUSPICIOUS_SERVICE_23",
                    packet.sourceIp,
                    23,
                    "Cleartext interactive Telnet administrative access attempted against core infrastructure."
                ));
            }

            // RULE 3: Volumetric Bandwidth Burst (Spike >= 5 MB in single telemetry cycle)
            if (packet.byteSize >= 5 * 1024 * 1024) {
                return Optional.of(new ThreatAlert(
                    "THR-" + (1000 + new Random().nextInt(9000)),
                    AlertSeverity.MEDIUM,
                    "TRAFFIC_SPIKE",
                    packet.sourceIp,
                    packet.port,
                    "Volumetric burst threshold exceeded: " + (packet.byteSize / (1024 * 1024)) + " MB payload transferred."
                ));
            }

            return Optional.empty();
        }

        // RULE 4: ARP Spoofing / MitM Cache Invalidation
        public Optional<ThreatAlert> evaluateArpBinding(String ip, String incomingMac) {
            if (arpTableCache.containsKey(ip)) {
                String knownMac = arpTableCache.get(ip);
                if (!knownMac.equalsIgnoreCase(incomingMac)) {
                    return Optional.of(new ThreatAlert(
                        "THR-" + (1000 + new Random().nextInt(9000)),
                        AlertSeverity.CRITICAL,
                        "ARP_SPOOFING",
                        ip,
                        0,
                        "Potential Man-in-the-Middle! IP " + ip + " changed physical MAC from " + knownMac + " to " + incomingMac
                    ));
                }
            } else {
                arpTableCache.put(ip, incomingMac);
            }
            return Optional.empty();
        }
    }

