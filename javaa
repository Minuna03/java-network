    public static class ThreatAlert {
        public String alertId;
        public String timestamp;
        public AlertSeverity severity;
        public String ruleName;
        public String sourceIp;
        public int targetPort;
        public String description;
        public String status;

        public ThreatAlert(String alertId, AlertSeverity severity, String ruleName, String sourceIp, int targetPort, String description) {
            this.alertId = alertId;
            this.timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("HH:mm:ss"));
            this.severity = severity;
            this.ruleName = ruleName;
            this.sourceIp = sourceIp;
            this.targetPort = targetPort;
            this.description = description;
            this.status = "NEW";
        }
    }

    public static class NetworkPacket {
        public String timestamp;
        public String sourceIp;
        public String destinationIp;
        public String protocol;
        public int port;
        public long byteSize;

        public NetworkPacket(String sourceIp, String destinationIp, String protocol, int port, long byteSize) {
            this.timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("HH:mm:ss"));
            this.sourceIp = sourceIp;
            this.destinationIp = destinationIp;
            this.protocol = protocol;
            this.port = port;
            this.byteSize = byteSize;
        }
    }

