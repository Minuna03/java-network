    public static class DatabaseManager {
        private static final String DB_URL = "jdbc:sqlite:network_guard.db";
        private Connection connection;

        public DatabaseManager() {
            try {
                // Initialize SQLite connection
                connection = DriverManager.getConnection(DB_URL);
                initTables();
            } catch (Exception e) {
                System.err.println("[DB-WARN] SQLite native driver not detected on classpath. Operating in volatile in-memory mode.");
            }
        }

        private void initTables() throws SQLException {
            if (connection == null) return;
            try (Statement stmt = connection.createStatement()) {
                stmt.execute("""
                    CREATE TABLE IF NOT EXISTS users (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        email VARCHAR(255) UNIQUE NOT NULL,
                        password_hash VARCHAR(64) NOT NULL,
                        salt VARCHAR(32) NOT NULL,
                        full_name VARCHAR(100),
                        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
                    );
                """);
                stmt.execute("""
                    CREATE TABLE IF NOT EXISTS devices (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        ip_address VARCHAR(45) UNIQUE NOT NULL,
                        mac_address VARCHAR(17),
                        hostname VARCHAR(255),
                        status VARCHAR(20) DEFAULT 'ONLINE',
                        risk_score INTEGER DEFAULT 10
                    );
                """);
                stmt.execute("""
                    CREATE TABLE IF NOT EXISTS threat_alerts (
                        id VARCHAR(50) PRIMARY KEY,
                        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
                        severity VARCHAR(20) NOT NULL,
                        rule_name VARCHAR(100) NOT NULL,
                        source_ip VARCHAR(45) NOT NULL,
                        target_port INTEGER,
                        description TEXT,
                        status VARCHAR(20) DEFAULT 'NEW'
                    );
                """);
            }
        }

        public void logAlert(ThreatAlert alert) {
            if (connection == null) return;
            String sql = "INSERT OR REPLACE INTO threat_alerts (id, severity, rule_name, source_ip, target_port, description, status) VALUES (?, ?, ?, ?, ?, ?, ?)";
            try (PreparedStatement pstmt = connection.prepareStatement(sql)) {
                pstmt.setString(1, alert.alertId);
                pstmt.setString(2, alert.severity.name());
                pstmt.setString(3, alert.ruleName);
                pstmt.setString(4, alert.sourceIp);
                pstmt.setInt(5, alert.targetPort);
                pstmt.setString(6, alert.description);
                pstmt.setString(7, alert.status);
                pstmt.executeUpdate();
            } catch (SQLException ignored) {}
        }
    }

