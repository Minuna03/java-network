    // ==========================================
    // 6. TELEMETRY & ATTACK SIMULATION WORKFLOW
    // ==========================================
    private void startTelemetryLoop() {
        String[] hosts = {"192.168.1.105", "192.168.1.120", "192.168.1.140", "192.168.1.150", "1.1.1.1"};
        String[] protos = {"HTTPS", "TCP", "UDP", "DNS"};
        int[] ports = {443, 80, 53, 22, 8080};

        scheduler.scheduleAtFixedRate(() -> {
            if (!isMonitoring) return;

            Random rand = new Random();
            currentThroughput = Math.max(12.0, Math.min(95.0, currentThroughput + (rand.nextDouble() * 6 - 3)));
            String src = hosts[rand.nextInt(hosts.length)];
            String dst = hosts[rand.nextInt(hosts.length)];
            String proto = protos[rand.nextInt(protos.length)];
            int port = ports[rand.nextInt(ports.length)];
            long bytes = (long) (rand.nextDouble() * 5000 + 200);

            NetworkPacket packet = new NetworkPacket(src, dst, proto, port, bytes);
            packetBuffer.add(0, packet);
            if (packetBuffer.size() > 40) packetBuffer.remove(packetBuffer.size() - 1);

            // Ingest packet through Threat Detection Engine
            Optional<ThreatAlert> alertOpt = threatEngine.evaluatePacket(packet);
            alertOpt.ifPresent(this::registerAlert);

            SwingUtilities.invokeLater(() -> {
                throughputLabel.setText(String.format("%.1f MB/s", currentThroughput));
                packetTableModel.insertRow(0, new Object[]{
                    packet.timestamp, packet.sourceIp, packet.destinationIp, packet.protocol, packet.port, packet.byteSize + " B", "ALLOWED"
                });
                if (packetTableModel.getRowCount() > 30) packetTableModel.removeRow(packetTableModel.getRowCount() - 1);
            });
        }, 1, 1, TimeUnit.SECONDS);
    }

    private void registerAlert(ThreatAlert alert) {
        alertList.add(0, alert);
        dbManager.logAlert(alert);
        recalculateSecurityScore();

        SwingUtilities.invokeLater(() -> {
            refreshThreatTable();
            JOptionPane.showMessageDialog(this,
                "Threat Rule Triggered: " + alert.ruleName + "\nSource: " + alert.sourceIp + "\n" + alert.description,
                "THE NETWORK GUARD - " + alert.severity + " ALERT",
                JOptionPane.WARNING_MESSAGE);
        });
    }

    private void recalculateSecurityScore() {
        int score = 94;
        for (ThreatAlert alert : alertList) {
            if (!"RESOLVED".equalsIgnoreCase(alert.status)) {
                if (alert.severity == AlertSeverity.CRITICAL) score -= 15;
                else if (alert.severity == AlertSeverity.HIGH) score -= 10;
                else if (alert.severity == AlertSeverity.MEDIUM) score -= 5;
            }
        }
        securityScore = Math.max(10, Math.min(100, score));

        SwingUtilities.invokeLater(() -> {
            scoreLabel.setText(securityScore + " / 100");
            scoreStatusLabel.setText(securityScore >= 80 ? "GOOD POSTURE" : "CRITICAL RISK");
            scoreStatusLabel.setForeground(securityScore >= 80 ? new Color(16, 185, 129) : new Color(239, 68, 68));
            activeThreatsLabel.setText(alertList.size() + " Active");
        });
    }

