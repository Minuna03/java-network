    // 7. VIVA DEMONSTRATION SIMULATION HOOKS
    // ==========================================
    private void runPortScanSimulation() {
        new Thread(() -> {
            for (int p : new int[]{21, 22, 23, 80, 443, 445, 8080}) {
                NetworkPacket probe = new NetworkPacket("192.168.1.150", "192.168.1.105", "TCP", p, 128);
                Optional<ThreatAlert> alert = threatEngine.evaluatePacket(probe);
                alert.ifPresent(this::registerAlert);
                try { Thread.sleep(200); } catch (InterruptedException ignored) {}
            }
        }).start();
    }

    private void runTelnetSimulation() {
        NetworkPacket telnetPkt = new NetworkPacket("192.168.1.140", "192.168.1.1", "TCP", 23, 512);
        threatEngine.evaluatePacket(telnetPkt).ifPresent(this::registerAlert);
    }

    private void runArpSpoofSimulation() {
        threatEngine.evaluateArpBinding("192.168.1.1", "AA:BB:CC:DD:EE:FF").ifPresent(this::registerAlert);
    }

    private void resetBaseline() {
        alertList.clear();
        alertList.add(new ThreatAlert("THR-1001", AlertSeverity.HIGH, "PORT_SCAN", "192.168.1.150", 445, "Probed 7 ports within 4.2 seconds."));
        recalculateSecurityScore();
        refreshThreatTable();
        JOptionPane.showMessageDialog(this, "Telemetry state and threat alerts restored to clean baseline.", "System Reset", JOptionPane.INFORMATION_MESSAGE);
